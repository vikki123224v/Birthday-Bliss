# ── Frontend Firebase Public Keys (safe to expose to browser client) ────────
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# ── Vercel Cron Security ─────────────────────────────────────────────────────
# Generate any secure random string (e.g. openssl rand -hex 32)
# When set in Vercel, Vercel automatically passes it in the Authorization header
CRON_SECRET=your_random_cron_secret_here

# ── Server-Side Firebase Admin (Set in Vercel Environment Variables only) ────
# Option A (Recommended): One-line JSON string of the downloaded Firebase service account key
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"..."}

# Option B: Individual fields if preferred
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your_project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Email Provider Configuration (Choose Gmail SMTP or Resend) ───────────────
# Option 1: Gmail SMTP via Nodemailer (100% Free, NO custom domain required!)
# Set up a Google account -> Enable 2FA -> Generate an App Password (16 characters)
EMAIL_PROVIDER=gmail
GMAIL_USER=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password
SENDER_NAME=Birthday Bliss

# Option 2: Resend (Requires a verified domain to send to arbitrary emails)
# Note: On the free Resend plan without a custom domain, onboarding@resend.dev
# can ONLY deliver emails to the email address registered on your Resend account.
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxx
# RESEND_FROM_EMAIL=Birthday Bliss <birthday@yourdomain.com>
